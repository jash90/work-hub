# work-hub — skopiuj do .env i uzupełnij. .env jest w .gitignore.

# --- Tokeny ---
# Jira — Personal Access Token
JIRA_TOKEN=
# GitLab — Personal Access Token
GITLAB_TOKEN=
# Confluence — Personal Access Token
CONFLUENCE_TOKEN=

# --- Jira i GitLab ---
# Adres Jiry
JIRA_BASE_URL=https://jira.example.com
# Klucze projektów
JIRA_PROJECT_KEYS=ABC, DEF
# Nazwa użytkownika w Tempo
TEMPO_USER=imie.nazwisko

# --- Hub ---
# Port
WORK_HUB_PORT=8787
# Przebieg poranny
WORK_HUB_PORANEK=10:00
# Przebieg popołudniowy
WORK_HUB_POPOLUDNIE=16:00
