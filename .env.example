# work-hub — copy to .env and fill in. .env is git-ignored.

# --- Tokens ---
# Jira — Personal Access Token
JIRA_TOKEN=
# GitLab — Personal Access Token
GITLAB_TOKEN=
# Confluence — Personal Access Token
CONFLUENCE_TOKEN=

# --- Jira and GitLab ---
# Jira address
JIRA_BASE_URL=https://jira.example.com
# Project keys
JIRA_PROJECT_KEYS=ABC, DEF
# Tempo username
TEMPO_USER=first.last

# --- Hub ---
# Port
WORK_HUB_PORT=8787
# Morning run
WORK_HUB_MORNING=10:00
# Afternoon run
WORK_HUB_AFTERNOON=16:00
